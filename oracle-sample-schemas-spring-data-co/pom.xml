<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.jinahya</groupId>
    <artifactId>oracle-sample-schemas-spring-data</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>oracle-sample-schemas-spring-data-co</artifactId>
  <packaging>jar</packaging>

  <description>Spring Data for the customer_orders schema</description>

  <dependencies>
    <!--
      main =======================================================================================
      The mapped superclasses the entities of this module extend, their static metamodel (MappedCustomer_, ...), and
      the converters and embeddables the mappings name. Upstream keeps its own entities in its test sources, so none
      arrive from the jar; the ones here, in the parent package of the repositories, are copies of them. Its jakarta.*
      dependencies are provided there, so none arrive transitively.
      -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>oracle-sample-schemas-persistence-co</artifactId>
    </dependency>

    <!-- test tools ================================================================================= -->
    <!-- The upstream randomizers and persisters. What they need comes from the root pom. -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>oracle-sample-schemas-persistence-co</artifactId>
      <classifier>test-companion</classifier>
      <scope>test</scope>
    </dependency>
    <!--
      What Product_Randomizer of that jar writes the PRODUCT_DETAILS JSON with; upstream has it at test scope, so the
      jar does not bring it. Jackson 2, from the jackson-bom of the root pom.
      -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
