<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.jinahya</groupId>
    <artifactId>oracle-sample-schemas-spring-data</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>oracle-sample-schemas-spring-data-co</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <description>Spring Data for the customer_orders schema</description>

  <dependencies>
    <!-- main ======================================================================================= -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>oracle-sample-schemas-persistence-co</artifactId>
    </dependency>

    <!-- test runtime =============================================================================== -->
    <!--
      The tests connect to a real Oracle instance (see src/test/resources/application.yaml). Test
      scope, so consumers get no driver. Version from the Boot BOM.
      -->
    <dependency><!-- https://central.sonatype.com/artifact/com.oracle.database.jdbc/ojdbc17 -->
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc17</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- test tools ================================================================================= -->
    <!-- The upstream randomizers and persisters. What they need comes from the root pom. -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>oracle-sample-schemas-persistence-co</artifactId>
      <classifier>test-companion</classifier>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
