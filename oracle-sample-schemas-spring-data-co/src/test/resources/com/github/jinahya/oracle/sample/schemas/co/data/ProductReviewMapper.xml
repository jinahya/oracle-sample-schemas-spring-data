<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  Statements of ProductReviewMapper, the same as ProductReviewRepositoryImpl's; countAllByProductName and
  findAllByProductName are @Select annotations on the interface instead, and use the productReview result map below.
  The view is qualified with its schema: hibernate.default_schema does not reach MyBatis.
  -->
<mapper namespace="com.github.jinahya.oracle.sample.schemas.co.data.ProductReviewMapper">

  <!-- ProductReview has a protected constructor only, which MyBatis calls reflectively, and setters. -->
  <resultMap id="productReview" type="com.github.jinahya.oracle.sample.schemas.persistence.co.ProductReview">
    <result column="PRODUCT_NAME" property="productName"/>
    <result column="RATING" property="rating"/>
    <result column="AVG_RATING" property="avgRating"/>
    <result column="REVIEW" property="review"/>
  </resultMap>

  <select id="countDistinctProductNames" resultType="long">
    SELECT COUNT(DISTINCT PRODUCT_NAME)
    FROM CO.PRODUCT_REVIEWS
  </select>

  <!--
    AVG_RATING is an average over PRODUCT_NAME, so a name has one; DISTINCT needs it selected to order by it, and the
    result map takes PRODUCT_NAME alone. A product with no reviews has no AVG_RATING, and comes last; PRODUCT_NAME
    breaks ties, so pages are stable.
    -->
  <resultMap id="productName" type="string">
    <result column="PRODUCT_NAME" javaType="string"/>
  </resultMap>

  <select id="findDistinctProductNamesOrderByAvgRating" resultMap="productName">
    SELECT DISTINCT PRODUCT_NAME, AVG_RATING
    FROM CO.PRODUCT_REVIEWS
    ORDER BY AVG_RATING DESC NULLS LAST, PRODUCT_NAME
    OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
  </select>
</mapper>
