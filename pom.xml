<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jinahya</groupId>
  <artifactId>oracle-sample-schemas-spring-data</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Spring Data for the Oracle Sample Database schemas</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <!--
    One module per sample schema: oracle-sample-schemas-spring-data-<schema> wraps
    io.github.jinahya:oracle-sample-schemas-persistence-<schema>.
    -->
  <modules>
    <module>oracle-sample-schemas-spring-data-co</module>
    <module>oracle-sample-schemas-spring-data-hr</module>
    <module>oracle-sample-schemas-spring-data-sh</module>
  </modules>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- The upstream entities are compiled at release 21; that is the floor. -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>

    <!--
      Boot 4, not 3: it manages jakarta.persistence-api 3.2, which the upstream mappings are written
      against. Boot 3.x manages 3.1. Do not downgrade.
      -->
    <!-- https://docs.spring.io/spring-boot/appendix/dependency-versions/coordinates.html -->
    <version.org.springframework.boot>4.1.1</version.org.springframework.boot>

    <!-- Local SNAPSHOTs only: `mvn install` the sibling checkout to pick up a change there. -->
    <version.oracle-sample-schemas-persistence>0.0.1-SNAPSHOT</version.oracle-sample-schemas-persistence>

    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-persistence-test-utils/versions -->
    <version.jinahya-persistence>0.6.2-SNAPSHOT</version.jinahya-persistence>

    <!-- Same property and value as upstream, which compiles its randomizers against it. -->
    <!-- https://central.sonatype.com/artifact/uk.co.jemos.podam/podam/versions -->
    <version.uk.co.jemos.podam>8.0.2.RELEASE</version.uk.co.jemos.podam>

    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>

    <!--
      jOOQ code generation; see the jooq-codegen profile. A BOM import carries no plugin versions,
      so these restate Boot's jooq.version and oracle-database.version; keep them in step.
      -->
    <version.jooq-codegen-maven>3.21.7</version.jooq-codegen-maven>
    <version.jooq-codegen.ojdbc>23.26.3.0.0</version.jooq-codegen.ojdbc>
    <!-- Boot's build-helper-maven-plugin.version, for the same reason. -->
    <version.build-helper-maven-plugin>3.6.1</version.build-helper-maven-plugin>
    <!-- The database of application.yaml. Override any of them with -D. -->
    <jooq-codegen.url>jdbc:oracle:thin:@//localhost:1521/freepdb1</jooq-codegen.url>
    <jooq-codegen.user>dmlonly</jooq-codegen.user>
    <jooq-codegen.password>password</jooq-codegen.password>
    <!-- On in a schema module only, which also sets jooq-codegen.inputSchema and .packageName. -->
    <jooq-codegen.skip>true</jooq-codegen.skip>
    <!-- Objects of the schema not to generate, a regular expression; none by default. -->
    <jooq-codegen.excludes></jooq-codegen.excludes>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Imported, not inherited: this pom is parent-less. Every Spring, Boot and Hibernate version
        comes from here, so dependencies on them carry no <version>.
        -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.org.springframework.boot}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- The upstream entity modules. -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-co</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-hr</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-sh</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>

      <!--
        Their randomizers and persisters, published as a second jar classified test-companion; a
        classifier needs an entry of its own. The jar brings none of its dependencies, so podam and
        jinahya-persistence-test-utils are declared below.
        -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-co</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-hr</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-sh</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>

      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-persistence-utils</artifactId>
        <version>${version.jinahya-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-persistence-test-utils</artifactId>
        <version>${version.jinahya-persistence}</version>
      </dependency>
      <dependency>
        <groupId>uk.co.jemos.podam</groupId>
        <artifactId>podam</artifactId>
        <version>${version.uk.co.jemos.podam}</version>
      </dependency>

      <!--
        Pinned over the BOM's 1.18.46, which fails on JDK 27 (ExceptionInInitializerError:
        com.sun.tools.javac.tree.EndPosTable). Raise it with the JDK; drop the pin once the BOM
        manages 1.18.48 or later. A direct entry beats an imported one.
        -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${version.org.projectlombok}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- What every schema module shares; a module's own pom names only its schema artifacts. -->
  <dependencies>
    <!-- main ======================================================================================= -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      test starters ==============================================================================
      Boot 4 pairs each starter with a spring-boot-starter-<technology>-test, and each of those brings
      spring-boot-starter-test, so that one is not declared.
      -->
    <!-- @DataJpaTest, @AutoConfigureTestDatabase, TestEntityManager -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Jackson 3, for an injected JsonMapper. Not part of the @DataJpaTest slice, so only a
      @SpringBootTest gets one.
      -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      jOOQ, test scope only, at the version Boot manages: a DSLContext on the test DataSource, and
      @JooqTest. The open source edition has no Oracle dialect, so against the installed schema it
      renders SQLDialect.DEFAULT.
      -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jooq-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Lets jOOQ map results into classes annotated with @Column, such as upstream's ProductReviews. -->
    <dependency>
      <groupId>org.jooq</groupId>
      <artifactId>jooq-jpa-extensions</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      test runtime ===============================================================================
      The embedded database @DataJpaTest swaps in for Oracle. Without one on the classpath,
      @AutoConfigureTestDatabase fails. The Oracle driver is per module.
      -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- test tools ================================================================================= -->
    <!-- Test sources only, as upstream does. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- What the upstream randomizers fill instances with. -->
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.15.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Lombok on the test sources' processor path only. The <path> takes its version from
        dependencyManagement, so the processor and the annotations stay in step.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- src/test/java-jooq, the committed output of the jooq-codegen profile, as a test source root. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${version.build-helper-maven-plugin}</version>
        <executions>
          <execution>
            <id>add-test-source-jooq</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/test/java-jooq</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Generates jOOQ classes for a schema's tables and views from the live database, by hand:

        mvn -P jooq-codegen -pl oracle-sample-schemas-spring-data-co generate-test-sources

      The output goes into src/test/java-jooq, a test source root of its own, and is committed: the
      schema is Oracle's, not ours, and a normal build must not need the database. jOOQ empties the
      target package on every run, so nothing hand-written belongs there.

      JDBCDatabase reads the generic JDBC metadata, which the open source edition supports for any
      database: tables, views, columns, keys, indexes. Oracle's own reader is commercial. Names are
      generated schema-qualified (CO.CUSTOMERS), as dmlonly has to address them.
      -->
    <profile>
      <id>jooq-codegen</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen-maven</artifactId>
            <version>${version.jooq-codegen-maven}</version>
            <executions>
              <execution>
                <id>jooq-codegen</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
            <dependencies>
              <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc17</artifactId>
                <version>${version.jooq-codegen.ojdbc}</version>
              </dependency>
            </dependencies>
            <configuration>
              <skip>${jooq-codegen.skip}</skip>
              <onError>FAIL</onError>
              <!-- LOG, the default: one set of forcedTypes serves all schemas, so some go unused. -->
              <onUnused>LOG</onUnused>
              <jdbc>
                <driver>oracle.jdbc.OracleDriver</driver>
                <url>${jooq-codegen.url}</url>
                <user>${jooq-codegen.user}</user>
                <password>${jooq-codegen.password}</password>
              </jdbc>
              <generator>
                <database>
                  <name>org.jooq.meta.jdbc.JDBCDatabase</name>
                  <inputSchema>${jooq-codegen.inputSchema}</inputSchema>
                  <includes>.*</includes>
                  <excludes>${jooq-codegen.excludes}</excludes>
                  <!--
                    JDBCDatabase reports Oracle's type names, which the open source edition does not
                    know; unmapped, every column would be SQLDataType.OTHER, i.e. Object. These map
                    them to standard types; the first match wins.

                    It reports no precision or scale either (every NUMBER is NUMBER(0, 0)), so an
                    integer NUMBER cannot be told from a decimal one by its type. A NUMBER is a
                    BigDecimal, then, except an *_ID column, which in these schemas is always a whole
                    number key.
                    -->
                  <forcedTypes>
                    <forcedType>
                      <name>BIGINT</name>
                      <includeTypes>NUMBER</includeTypes>
                      <includeExpression>.*_ID</includeExpression>
                    </forcedType>
                    <forcedType>
                      <name>NUMERIC</name>
                      <includeTypes>NUMBER|FLOAT|BINARY_(FLOAT|DOUBLE)</includeTypes>
                    </forcedType>
                    <forcedType>
                      <name>VARCHAR</name>
                      <includeTypes>N?VARCHAR2.*|N?CHAR.*</includeTypes>
                    </forcedType>
                    <forcedType>
                      <name>TIMESTAMP</name>
                      <includeTypes>DATE|TIMESTAMP.*</includeTypes>
                    </forcedType>
                    <forcedType>
                      <name>BLOB</name>
                      <includeTypes>BLOB|RAW.*|LONG RAW</includeTypes>
                    </forcedType>
                    <forcedType>
                      <name>CLOB</name>
                      <includeTypes>N?CLOB</includeTypes>
                    </forcedType>
                  </forcedTypes>
                </database>
                <target>
                  <packageName>${jooq-codegen.packageName}</packageName>
                  <directory>${project.basedir}/src/test/java-jooq</directory>
                </target>
              </generator>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
