<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jinahya</groupId>
  <artifactId>oracle-sample-schemas-spring-data</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Spring Data for the Oracle Sample Database schemas</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <!--
    One module per sample schema, named <schema>-spring-data after the artifact it wraps: co-spring-data
    depends on com.github.jinahya:co, and so on. The schema modules of oracle-sample-schemas-persistence
    take the bare schema name (co, hr, sh), so the suffix is what keeps the two projects' artifacts apart
    on one classpath.
    -->
  <modules>
    <module>co-spring-data</module>
    <module>hr-spring-data</module>
    <module>sh-spring-data</module>
  </modules>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      The entities of oracle-sample-schemas-persistence publish their main sources at release 21,
      so 21 is the floor for anything consuming them.
      -->
    <maven.compiler.release>21</maven.compiler.release>

    <!--
      Spring Boot 4.x is the line that matches those entities: it manages jakarta.persistence-api
      3.2.0, the same Jakarta Persistence generation the mappings are written against, and it is
      built on the Jakarta EE 11 baseline. Boot 3.5 and earlier sit on Jakarta EE 10
      (jakarta.persistence-api 3.1), which does not know @EmbeddedId/@IdClass entities compiled
      against 3.2 API surface. Do not fall back to the 3.x line to avoid an upgrade.
      -->
    <!-- https://docs.spring.io/spring-boot/appendix/dependency-versions/coordinates.html -->
    <version.org.springframework>7.0.9</version.org.springframework>
    <version.org.springframework.boot>4.1.1</version.org.springframework.boot>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>

    <!--
      The entity modules this project wraps. They are SNAPSHOTs published nowhere but the local
      repository, so a change over there has to be `mvn install`ed from that checkout before it is
      visible here.
      -->
    <version.oracle-sample-schemas-persistence>0.0.1-SNAPSHOT</version.oracle-sample-schemas-persistence>

    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>

    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-persistence-test-utils/versions -->
    <version.jinahya-persistence>0.6.0</version.jinahya-persistence>

    <!-- https://central.sonatype.com/artifact/org.instancio/instancio-core/versions -->
    <version.org.instancio>6.0.1</version.org.instancio>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        The Spring Boot BOM, imported rather than inherited: this project keeps its own parent-less
        pom, so spring-boot-starter-parent is not in play, and every Spring/Boot/Hibernate version
        comes from here with no <version> spelled out at the dependency.
        -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.org.springframework.boot}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        The entity modules, managed here so that a schema module names groupId/artifactId only, and the
        upstream version moves in one place.
        -->
      <dependency>
        <groupId>com.github.jinahya</groupId>
        <artifactId>co</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <dependency>
        <groupId>com.github.jinahya</groupId>
        <artifactId>hr</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <dependency>
        <groupId>com.github.jinahya</groupId>
        <artifactId>sh</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <!--
        Lombok, pinned instead of left to the Boot BOM. This is the one place in this pom that
        spells out a version the BOM already manages, and it is not a preference: the BOM's
        1.18.46 cannot compile anything on the JDK this build runs on. Lombok reaches into javac
        internals, so each new JDK needs a new lombok, and on JDK 27 that version dies in
        testCompile with `ExceptionInInitializerError: com.sun.tools.javac.tree.EndPosTable`;
        1.18.48 is the current release and handles it. Raise this when the JDK moves, never lower
        it, and drop the pin once a Boot BOM manages 1.18.48 or later.

        A directly declared entry wins over one arriving through <scope>import</scope> whichever
        comes first, so this beats spring-boot-dependencies above. It is also where the
        version-less <path> in the maven-compiler-plugin configuration below reads its version.
        -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${version.org.projectlombok}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!--
    Every schema module is the same shape - Spring Data JPA over one entity module - so what they share
    is declared once here, and a module's own pom names only its schema artifact.
    -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Boot 4 broke the test slices out of spring-boot-test-autoconfigure into one module per
      technology, so @DataJpaTest is no longer something spring-boot-starter-test carries: it lives
      in spring-boot-data-jpa-test, which this starter brings along with @AutoConfigureTestDatabase
      (spring-boot-jdbc-test) and TestEntityManager (spring-boot-jpa-test). The classic aggregate
      is still published as spring-boot-starter-test-classic; prefer the per-slice starter.

      NOTE: @DataJpaTest still implies @AutoConfigureTestDatabase, whose `replace` now defaults to
      Replace.NON_TEST, meaning it swaps the auto-configured DataSource for an embedded one rather
      than using the schema module's own. See the H2 entry below for which of the two a given slice
      test gets and how to say so.
      -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      H2, the in-memory half of the story. Upstream runs the same entities two ways: `__co_testPU`
      against H2 and `__co_itPU` against the installed schema, and this is what lets a module here
      do the same. It is also what @AutoConfigureTestDatabase looks for: with no embedded database
      on the classpath, its Replace.NON_TEST default has nothing to replace the DataSource with and
      fails outright.

      Version from the imported Boot BOM (h2.version). Test scope only: nothing in src/main knows
      about a database.

      NOTE: putting H2 here changes what a bare @DataJpaTest does. It no longer fails; it quietly
      swaps H2 in for the Oracle DataSource, and the schema module's own application.yaml follows it
      there, so `hibernate.default_schema: CO` and `ddl-auto: none` then mean an empty H2 with no
      CO schema in it ("Schema CO not found"). Pick one deliberately, per test:

        @DataJpaTest(properties = {"spring.jpa.properties.hibernate.default_schema=",
                                   "spring.jpa.hibernate.ddl-auto=create-drop"})   generated H2
        @DataJpaTest @AutoConfigureTestDatabase(replace = Replace.NONE)            installed schema
      -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Lombok, for the test sources only, the way the upstream project scopes it. It stays out of
      src/main deliberately: the entities it wraps are hand written and standalone by design, and a
      published artifact should not ask its consumers to think about a compile-time-only processor.

      Version comes from this pom's own dependencyManagement rather than the BOM, for the reason
      given up there. Being a dependency puts the annotations on the test compile classpath;
      running the processor needs the maven-compiler-plugin configuration further down as well.
      -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The same test utilities the upstream project uses, on the same version property name, so that
      a test written there moves here unchanged. Note the groupId is io.github.jinahya, not the
      com.github.jinahya this project publishes under.
      -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-test-utils</artifactId>
      <version>${version.jinahya-persistence}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Instancio, what the *_Randomizer classes fill instances with. __Randomizer offers four
      backends as nested classes (___OfPodam, ___OfInstancio, ___OfEasyRandom, ___OfFixtureMonkey)
      and declares none of them itself, so the one actually extended has to be named here.
      ___OfInstancio exposes Settings and InstancioObjectApi as its override points, both from
      instancio-core, so the core artifact is enough; instancio-junit would only add the
      @InstancioExtension / @Seed lifecycle, which these randomizers do not use.
      -->
    <dependency>
      <groupId>org.instancio</groupId>
      <artifactId>instancio-core</artifactId>
      <version>${version.org.instancio}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.15.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Lombok is test scope, so it is the test sources that need it on the annotation processor
        path, and only they. Hence the configuration sits on the default-testCompile execution
        rather than on the plugin: `annotationProcessorPaths` switches processor discovery off for
        anything outside the paths it lists, and src/main has nothing to discover here (the static
        metamodel is generated upstream and arrives inside the entity jars, already compiled).

        The <path> carries no <version> on purpose. Since 3.12.0 the plugin falls back to
        dependencyManagement for it, which here means the pinned entry above, so the processor that
        runs and the annotations that are compiled against can never drift apart.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
