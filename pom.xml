<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jinahya</groupId>
  <artifactId>oracle-sample-schemas-spring-data</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Spring Data for the Oracle Sample Database schemas</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <!--
    One module per sample schema: oracle-sample-schemas-spring-data-<schema> wraps
    io.github.jinahya:oracle-sample-schemas-persistence-<schema>.
    -->
  <modules>
    <module>oracle-sample-schemas-spring-data-co</module>
    <module>oracle-sample-schemas-spring-data-hr</module>
    <module>oracle-sample-schemas-spring-data-sh</module>
  </modules>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- The upstream entities are compiled at release 21; that is the floor. -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <!--
      Keep parameter names in the class files, as upstream does: method validation reports them
      (findAllByProductName.offset, not .arg1), and Spring Data and MyBatis can bind named
      parameters by them.
      -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!--
      Boot 4, not 3: it manages jakarta.persistence-api 3.2, which the upstream mappings are written
      against. Boot 3.x manages 3.1. Do not downgrade.
      -->
    <!-- https://docs.spring.io/spring-boot/appendix/dependency-versions/coordinates.html -->
    <version.org.springframework.boot>4.1.1</version.org.springframework.boot>

    <!-- Local SNAPSHOTs only: `mvn install` the sibling checkout to pick up a change there. -->
    <version.oracle-sample-schemas-persistence>0.0.1-SNAPSHOT</version.oracle-sample-schemas-persistence>

    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-persistence-test-utils/versions -->
    <version.jinahya-persistence>0.6.2-SNAPSHOT</version.jinahya-persistence>

    <!-- Same property and value as upstream, which compiles its randomizers against it. -->
    <!-- https://central.sonatype.com/artifact/uk.co.jemos.podam/podam/versions -->
    <version.uk.co.jemos.podam>8.0.2.RELEASE</version.uk.co.jemos.podam>

    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>

    <!--
      Not in Boot's BOM. mybatis-spring-boot 4.1.0 is built against Boot 4.1.0, MyBatis 3.5.19 and
      mybatis-spring 4.1.0.
      https://central.sonatype.com/artifact/org.mybatis.spring.boot/mybatis-spring-boot-starter/versions
      -->
    <version.org.mybatis.spring.boot>4.1.0</version.org.mybatis.spring.boot>
    <!-- https://central.sonatype.com/artifact/org.mybatis/mybatis-spring/versions -->
    <version.org.mybatis.mybatis-spring>4.1.0</version.org.mybatis.mybatis-spring>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Imported, not inherited: this pom is parent-less. Every Spring, Boot and Hibernate version
        comes from here, so dependencies on them carry no <version>.
        -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.org.springframework.boot}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- The upstream entity modules. -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-co</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-hr</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-sh</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
      </dependency>

      <!--
        Their randomizers and persisters, published as a second jar classified test-companion; a
        classifier needs an entry of its own. The jar brings none of its dependencies, so podam and
        jinahya-persistence-test-utils are declared below.
        -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-co</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-hr</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>oracle-sample-schemas-persistence-sh</artifactId>
        <version>${version.oracle-sample-schemas-persistence}</version>
        <classifier>test-companion</classifier>
      </dependency>

      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-persistence-utils</artifactId>
        <version>${version.jinahya-persistence}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>jinahya-persistence-test-utils</artifactId>
        <version>${version.jinahya-persistence}</version>
      </dependency>
      <dependency>
        <groupId>uk.co.jemos.podam</groupId>
        <artifactId>podam</artifactId>
        <version>${version.uk.co.jemos.podam}</version>
      </dependency>

      <!--
        Pinned over the BOM's 1.18.46, which fails on JDK 27 (ExceptionInInitializerError:
        com.sun.tools.javac.tree.EndPosTable). Raise it with the JDK; drop the pin once the BOM
        manages 1.18.48 or later. A direct entry beats an imported one.
        -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${version.org.projectlombok}</version>
      </dependency>

      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis-spring</artifactId>
        <version>${version.org.mybatis.mybatis-spring}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${version.org.mybatis.spring.boot}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter-test</artifactId>
        <version>${version.org.mybatis.spring.boot}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- What every schema module shares; a module's own pom names only its schema artifacts. -->
  <dependencies>
    <!--
      main =======================================================================================
      The plain artifacts, not spring-boot-starter-data-jpa: the repositories need Spring Data JPA, not
      Boot, so the published pom names no starter. It is provided; a consumer brings its own Spring Data
      JPA and JPA provider. The starter reaches the tests through spring-boot-starter-data-jpa-test.

      jakarta.persistence-api is declared, provided, since main code uses JPA types itself
      (_NonEntityRepositoryImpl's EntityManager); spring-data-jpa does not bring it.
      -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-jpa</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Bean Validation constraints on repository method parameters (@NotBlank, @Positive, ...). The API
      only, provided: enforcing them takes a provider and @Validated, which the application brings.
      -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Main and test sources alike. Provided: Lombok is a compile-time tool only, so it is neither
      packaged nor passed on to consumers of these jars.
      -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      test starters ==============================================================================
      Boot 4 pairs each starter with a spring-boot-starter-<technology>-test, and each of those brings
      spring-boot-starter-test, so that one is not declared.
      -->
    <!-- @DataJpaTest, @AutoConfigureTestDatabase, TestEntityManager -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Jackson 3, for an injected JsonMapper. Not part of the @DataJpaTest slice, so only a
      @SpringBootTest gets one.
      -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Hibernate Validator, and Boot's method validation, which enforces the repositories' constraints;
      through spring-boot-starter-validation, which this brings.
      -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      MyBatis, test scope only: native SQL against Oracle, where jOOQ's open source edition has no
      dialect. mybatis-spring is what mappers compile against; the starter brings it too.
      -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis-spring</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @MybatisTest -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      test runtime ===============================================================================
      The embedded database @DataJpaTest swaps in for Oracle. Without one on the classpath,
      @AutoConfigureTestDatabase fails. The Oracle driver is per module.
      -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- test tools ================================================================================= -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>jinahya-persistence-test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- What the upstream randomizers fill instances with. -->
    <dependency>
      <groupId>uk.co.jemos.podam</groupId>
      <artifactId>podam</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.15.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Lombok on the processor path of both executions, default-compile and default-testCompile.
        The <path> takes its version from dependencyManagement, so the processor and the
        annotations stay in step.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
