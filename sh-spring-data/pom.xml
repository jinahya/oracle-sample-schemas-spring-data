<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.jinahya</groupId>
    <artifactId>oracle-sample-schemas-spring-data</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>sh-spring-data</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <description>Spring Data for the sales_history schema</description>

  <dependencies>
    <dependency>
      <groupId>com.github.jinahya</groupId>
      <artifactId>sh</artifactId>
    </dependency>
    <!--
      The tests in src/test/resources/application.yaml connect to a real Oracle instance, so the
      thin driver has to be on the test classpath; the module itself imposes no driver on its
      consumers. Version comes from the imported Boot BOM (oracle-database.version), so none is
      spelled out here. ojdbc17 is the JDK 17+ build, which maven.compiler.release 21 satisfies;
      it is also what the upstream project builds against.
      -->
    <dependency><!-- https://central.sonatype.com/artifact/com.oracle.database.jdbc/ojdbc17 -->
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc17</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
